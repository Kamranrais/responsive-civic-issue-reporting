# Environment Variables — JanSight
# Copy this file to .env and fill in your credentials.
# NEVER commit .env to version control.

# ─── Supabase ────────────────────────────────────────────────────────────────
# Your project URL (from Supabase → Settings → API)
VITE_SUPABASE_URL=

# Anon/public key (safe to expose to the browser — RLS protects your data)
VITE_SUPABASE_ANON_KEY=

# ─── Google Gemini AI ─────────────────────────────────────────────────────────
# Get a key at https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=

# ─── n8n Webhook (optional) ──────────────────────────────────────────────────
# Called when a new report is submitted, to trigger workflow automation
VITE_N8N_WEBHOOK_URL=

# ─── Demo Mode ───────────────────────────────────────────────────────────────
# Set to "true" to force Demo Mode (all data stays in localStorage)
# If VITE_SUPABASE_URL is empty, Demo Mode is activated automatically.
VITE_DEMO_MODE=
